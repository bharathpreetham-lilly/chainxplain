# ===========================
# ChainXplain Configuration
# ===========================

# === AI API Keys ===
# Required: Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Optional: For GPT models (if using OpenAI extra)
# OPENAI_API_KEY=sk-xxx

# === Blockchain Explorer API Keys ===
# Ethereum Etherscan (https://etherscan.io/apis)
ETHERSCAN_API_KEY=YourApiKeyToken

# Optional: For multi-chain support
POLYGONSCAN_API_KEY=YourApiKeyToken
ARBISCAN_API_KEY=YourApiKeyToken
BSCSCAN_API_KEY=YourApiKeyToken
OPTIMISTIC_ETHERSCAN_API_KEY=YourApiKeyToken

# === Alchemy API Keys (Recommended for better reliability) ===
# Get your key from https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your-alchemy-api-key-here

# Or use chain-specific Alchemy keys:
# ALCHEMY_ETHEREUM_API_KEY=your-eth-key
# ALCHEMY_POLYGON_API_KEY=your-polygon-key
# ALCHEMY_ARBITRUM_API_KEY=your-arbitrum-key
# ALCHEMY_BASE_API_KEY=your-base-key
# ALCHEMY_OPTIMISM_API_KEY=your-optimism-key

# === RPC Endpoints (Optional) ===
# Public RPCs are used by default if not specified
# ETHEREUM_RPC_URL=https://eth.llamarpc.com
# POLYGON_RPC_URL=https://polygon.llamarpc.com
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# OPTIMISM_RPC_URL=https://mainnet.optimism.io
# BSC_RPC_URL=https://bsc-dataseed.binance.org

# === Advanced Settings ===
# Cache TTL in seconds (default: 3600)
# CACHE_TTL=3600

# Rate limit: requests per second (default: 5)
# RATE_LIMIT=5

# Default chain (default: ethereum)
# DEFAULT_CHAIN=ethereum

# Claude model (default: claude-3-5-sonnet-20241022)
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Max tokens for AI responses (default: 4096)
# MAX_TOKENS=4096
